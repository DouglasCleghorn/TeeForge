<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TeeForge</AssemblyName>
    <RootNamespace>TeeForge</RootNamespace>
    <PackageId>TeeForge</PackageId>
    <Title>TeeForge</Title>
    <Version>0.1.0</Version>
    <Authors>Doug Cleghorn</Authors>
    <Copyright>Copyright Â© 2026 Doug Cleghorn</Copyright>
    <Description>High-performance .NET streams for mirrored I/O, write-only replication, buffered fan-out, multi-hashing, broadcast pipelines, headerless erasure coding, HTTP range reads, and mutually authenticated QUIC.</Description>
    <PackageTags>stream;pipe;pipelines;broadcast;tee;raid;replication;io;hash;cryptography;erasure-coding;random-access;http-range;quic;mtls</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>teeforge-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Stream composition, mirrored and buffered I/O, hashing, broadcast pipelines, headerless erasure coding, HTTP ranges, and mutually authenticated QUIC. See CHANGELOG.md.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DouglasCleghorn/TeeForge</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DouglasCleghorn/TeeForge</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../assets/teeforge-icon.png" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- GitHub resolves relative images for private repositories; NuGet requires an absolute image URL. -->
  <Target Name="PrepareNuGetReadme" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_NuGetReadmePath>$(IntermediateOutputPath)package/README.md</_NuGetReadmePath>
      <_NuGetReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../README.md').Replace('](assets/teeforge-icon.png)', '](https://raw.githubusercontent.com/DouglasCleghorn/TeeForge/main/assets/teeforge-icon.png)'))</_NuGetReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NuGetReadmePath)" Lines="$([MSBuild]::Escape('$(_NuGetReadmeText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <None Include="$(_NuGetReadmePath)" Pack="true" PackagePath="/README.md" />
    </ItemGroup>
  </Target>
</Project>
